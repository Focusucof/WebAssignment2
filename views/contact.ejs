<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap">
  </head>
  <body class="page">
    <%- include('components/navbar') %>

    <main class="page-container container">
      <h1 class="display-4 fw-bold">Contact</h1>

      <div class="row mt-4">
        <div class="col-12">
          <form action="mailto:devin.boodoo@ontariotechu.net" method="post" enctype="text/plain"
                class="box border p-4">
            <div class="mb-3">
              <label for="name" class="form-label mono mono-sm">NAME</label>
              <input type="text" id="name" name="name" class="form-control" required>
            </div>

            <div class="mb-3">
              <label for="email" class="form-label mono mono-sm">EMAIL</label>
              <input type="email" id="email" name="email" class="form-control" required>
            </div>

            <div class="mb-3">
              <label for="phone" class="form-label mono mono-sm">PHONE</label>
              <input type="tel" id="phone" name="phone" class="form-control" required>
            </div>

            <div class="mb-4">
              <label for="message" class="form-label mono mono-sm">MESSAGE</label>
              <textarea id="message" name="message" class="form-control" maxlength="500" required></textarea>
            </div>

            <button type="submit" class="box mono mono-sm border px-4 py-3 m-auto d-flex align-items-center justify-content-center">
              <i class="fa-solid fa-paper-plane me-2"></i>SEND
            </button>
          </form>
        </div>
      </div>
    </main>

    <%- include('components/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
