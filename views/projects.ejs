<!DOCTYPE html>
<html>
  <%- include('components/head', { title: title }) %>
  <body class="page">
    <%- include('components/navbar') %>

    <main class="page-container container">
      <h1 class="display-4 fw-bold">Projects</h1>

      <!-- 1 column on small screens, 2 on medium and up -->
      <div class="row row-cols-1 row-cols-md-2 g-4 mt-4">
        <% projects.forEach(function(project) { %>
          <div class="col">
            <a href="<%= project.url %>" target="_blank" rel="noopener noreferrer" class="box d-block h-100 border p-4 text-decoration-none">
              <img src="<%= project.image %>" alt="<%= project.name %> logo" class="box-icon mb-3">
              <h2 class="mono h5 fw-medium text-uppercase"><%= project.name %></h2>
              <p><%= project.description %></p>
              <span class="mono mono-sm">VISIT <i class="fa-solid fa-arrow-right"></i></span>
            </a>
          </div>
        <% }); %>
      </div>
    </main>

    <%- include('components/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
